````markdown
```mermaid
graph TD
  BS[BS (Bootstrap Server)]
  CLIENTS[Clients (client1–client5)]
  HTTP_SERVER[HTTP Server]
  UDP_SERVER[UDP Server]
  HTTP_CLIENT[HTTP Client]
  UDP_CLIENT[UDP Client]
  MAIN[(Main Node)\nregister, update table,\nfile memory, request processing]
  FILE_MEMORY[File Name Memory]
  FILE_REQUEST[File Request]
  FILE_RESPONSE[File Response]
  FILE_GEN[File Generator]
  PROPERTY_LOADER[Property Loader]
  PROP_FILE[Property File\n(bs & node addresses)]
  HTTP_CONTROLLER[HTTP Controller]
  UDP_CONTROLLER[UDP Controller]
  HTTP_REQ[HTTP Request Maker]
  UDP_REQ[UDP Request Maker]
  HTTP_RESP[HTTP Response Maker]
  UDP_RESP[UDP Response Maker]
  HTTP_CONN[HTTP Connection Pool]
  UDP_CONN[UDP Connection Pool]
  QUERY_ROUTING[Query Routing Table]
  NEIGHBOR[Neighbor Table]

  CLIENTS -->|Register| BS
  BS --> MAIN
  MAIN --> FILE_MEMORY
  MAIN --> HTTP_REQ
  MAIN --> UDP_REQ
  MAIN --> UDP_CONTROLLER
  MAIN --> HTTP_CONTROLLER
  MAIN --> QUERY_ROUTING
  MAIN --> NEIGHBOR
  NEIGHBOR --> UDP_CONTROLLER
  NEIGHBOR --> MAIN
  UDP_REQ --> UDP_CLIENT
  HTTP_REQ --> HTTP_CLIENT
  FILE_REQUEST --> MAIN
  FILE_MEMORY --> HTTP_CONTROLLER
  FILE_MEMORY --> UDP_CONTROLLER
  UDP_CONTROLLER -->|Check| FILE_MEMORY
  UDP_CONTROLLER --> UDP_RESP
  UDP_CONTROLLER --> UDP_REQ
  HTTP_CONTROLLER --> HTTP_RESP
  HTTP_CONTROLLER --> FILE_MEMORY
  FILE_GEN --> HTTP_CONTROLLER
  FILE_GEN --> FILE_MEMORY
  FILE_RESPONSE --> FILE_REQUEST
  HTTP_REQ --> HTTP_CONN
  UDP_REQ --> UDP_CONN
  PROP_FILE --> PROPERTY_LOADER
  PROPERTY_LOADER --> MAIN
  FILE_GEN --> HTTP_CONTROLLER
```
